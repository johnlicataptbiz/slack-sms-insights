{
  "name": "slack-sms-insights",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=ptbizsms-api\" \"npm run dev --workspace=ptbizsms-dashboard\"",
    "dev:backend": "npm run dev --workspace=ptbizsms-api",
    "dev:frontend": "npm run dev --workspace=ptbizsms-dashboard",
    "build": "npm run --workspace=ptbizsms-api build && npm run --workspace=ptbizsms-dashboard build",
    "build:backend": "npm run --workspace=ptbizsms-api build",
    "build:frontend": "npm run --workspace=ptbizsms-dashboard build",
    "lint": "npm run --workspace=ptbizsms-api lint && npm run --workspace=ptbizsms-dashboard lint",
    "lint:backend": "npm run --workspace=ptbizsms-api lint",
    "lint:frontend": "npm run --workspace=ptbizsms-dashboard lint",
    "test": "npm run --workspace=ptbizsms-api test && npm run --workspace=ptbizsms-dashboard test",
    "typecheck": "npm run --workspace=ptbizsms-dashboard typecheck:v2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "@biomejs/biome": "^2.4.2",
    "@types/node": "^25.3.0"
  }
}