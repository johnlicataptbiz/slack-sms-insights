// This is a unified Prisma schema for the SMS Insights project
// Last updated: 2026-04-03

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["jsonProtocol", "fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Existing SMS Events Model (enhanced)
model SmsEvent {
  id                   String    @id @default(cuid())
  body                 String?
  direction            String?
  sender               String?
  recipient            String?
  threadId             String?
  deliveryStatus       String?
  
  // AI Classification Columns
  aiSentimentLabel     String?
  aiConfidenceScore    Float?
  aiIntentCategory     String?
  
  // Multilingual Support
  detectedLanguage     String?
  
  // Metadata
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  // Manual Review Flag
  manuallyReviewed     Boolean   @default(false)
  
  // Indexes for performance
  @@index([threadId])
  @@index([sender])
  @@index([recipient])
  @@index([aiSentimentLabel])
  @@index([detectedLanguage])
}

// Machine Learning Model Performance Tracking
model MlModelPerformance {
  id                   String    @id @default(cuid())
  timestamp            DateTime  @default(now())
  
  // Core Performance Metrics
  accuracy             Float
  precision            Float
  recall               Float
  f1Score              Float
  
  // Detailed Confusion Matrix
  confusionMatrix      Json?
  
  // Contextual Information
  modelVersion         String?
  trainingDataSize     Int?
  
  @@index([timestamp])
  @@index([modelVersion])
}

// Bias Detection Metrics
model MlBiasDetection {
  id                   String    @id @default(cuid())
  timestamp            DateTime  @default(now())
  
  // Comprehensive Bias Metrics
  biasMetrics          Json
  
  // Attributes Analyzed
  analyzedAttributes   String[]
  
  // Deviation Scores
  maxDeviationScore    Float?
  
  @@index([timestamp])
  @@index([analyzedAttributes])
}

// Machine Learning Model Storage
model MlModel {
  id                   String    @id @default(cuid())
  version              String    @unique
  filename             String
  
  // Training Metadata
  timestamp            DateTime  @default(now())
  trainingDataSize     Int?
  
  // Performance Metrics
  metrics              Json
  
  // Model Configuration
  hyperparameters      Json?
  tags                 String[]
  
  @@index([version])
  @@index([timestamp])
  @@index([tags])
}

// Language Detection and Translation Tracking
model LanguageDetectionLog {
  id                   String    @id @default(cuid())
  originalText         String
  detectedLanguage     String
  confidence           Float
  
  // Translation Details (if applicable)
  translatedText       String?
  targetLanguage       String?
  
  timestamp            DateTime  @default(now())
  
  @@index([detectedLanguage])
  @@index([timestamp])
}

// Sentiment Classification Training Log
model SentimentTrainingLog {
  id                   String    @id @default(cuid())
  trainingRun          String
  
  // Training Dataset Metrics
  totalSamples         Int
  positiveSamples      Int
  negativeSamples      Int
  neutralSamples       Int
  
  // Performance Metrics
  accuracy             Float
  precisionPositive    Float
  precisionNegative    Float
  precisionNeutral     Float
  
  // Contextual Information
  languagesIncluded    String[]
  modelVersion         String
  
  timestamp            DateTime  @default(now())
  
  @@index([trainingRun])
  @@index([timestamp])
  @@index([modelVersion])
}