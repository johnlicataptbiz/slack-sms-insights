  updated_at   DateTime  @updatedAt

  @@index([updated_at(sort: Desc)])
}

model monday_weekly_reports {
  week_start      DateTime @id
  source_board_id String?
  summary_json    Json
  monday_item_id  String?
  synced_at       DateTime @default(now())

  @@index([week_start(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model send_attempts {
  id                 String       @id @default(cuid())
  conversation_id    String      
  message_body       String
  sender_identity    String?
  line_id            String?
  from_number        String?
  allowlist_decision Boolean      @default(false)
  dnc_decision       Boolean      @default(false)
  idempotency_key    String?
  status             SendAttemptStatus
  retry_count        Int          @default(0)
  request_payload    String?
  response_payload   String?
  error_message      String?
  created_at         DateTime     @default(now())
  conversations      Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sequence_version_decisions {
  sequence_label String   @id
  status         SequenceVersionStatus
  updated_by     String?
  updated_at     DateTime @updatedAt

  @@index([status, updated_at(sort: Desc)])
}

model sequence_registry {
  id               String                 @id @default(cuid())
  label            String
  normalized_label String                 @unique
  status           SequenceRegistryStatus @default(active)
  lead_magnet      String?
  version_tag      String?
  owner_rep        String?
  is_manual_bucket Boolean                @default(false)
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  aliases          sequence_aliases[]
  facts_booking    fact_booking_daily[]
  facts_lead       fact_lead_quality_daily[]
  facts_sms        fact_sms_daily[]
  sms_events       sms_events[]

  @@index([status])
  @@index([is_manual_bucket])
}

model sequence_aliases {
  raw_label        String            @id
  normalized_label String
  sequence_id      String           
  created_at       DateTime          @default(now())
  sequence         sequence_registry @relation(fields: [sequence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sequence_id])
  @@index([normalized_label])
}

model fact_sms_daily {
  day                   DateTime         
  sequence_id           String           
  rep_id                String
  messages_sent         Int               @default(0)
