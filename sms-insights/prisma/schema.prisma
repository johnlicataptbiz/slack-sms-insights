generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model ActionLog {
  id          String   @id
  actionType  String
  description String
  metadata    Json?
  userId      String?
  sessionId   String?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])

  @@index([actionType])
  @@index([createdAt])
  @@index([userId])
}

model CoachingAnalysis {
  id                     String          @id
  userId                 String?
  sessionId              String?
  coachName              String?
  clientName             String?
  callDate               String?
  score                  Int
  outcome                String
  summary                String
  phaseScores            Json
  strengths              Json
  improvements           Json
  redFlags               Json
  gradingVersion         String          @default("v1")
  deterministic          Json?
  criticalBehaviors      Json?
  confidence             Int?
  qualityGate            Json?
  evidence               Json?
  transcriptHash         String?
  deidentifiedTranscript String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime
  User                   User?           @relation(fields: [userId], references: [id])
  PdfExport              PdfExport[]
  ZoomRecording          ZoomRecording[]

  @@index([createdAt])
  @@index([userId])
}

model KnowledgeDoc {
  id        String   @id
  slug      String?  @unique
  title     String
  content   String
  category  String
  source    String?
  version   String   @default("2026.02")
  checksum  String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category])
}

model LoginEvent {
  id         String   @id
  userId     String?
  success    Boolean  @default(true)
  rememberMe Boolean?
  sessionId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([success])
  @@index([userId])
}

model PLImportBatch {
  id                String              @id
  userId            String?
  name              String?
  programType       String              @default("mastermind")
  status            String              @default("draft")
  overallConfidence Int                 @default(0)
  timelinePayload   Json?
  warningSummary    Json?
  approvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  User              User?               @relation(fields: [userId], references: [id])
  PLImportBatchItem PLImportBatchItem[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model PLImportBatchItem {
  id              String          @id
  batchId         String
  importSessionId String
  periodLabel     String
  periodOrder     Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  PLImportBatch   PLImportBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@unique([batchId, importSessionId])
  @@unique([batchId, periodOrder])
  @@index([importSessionId])
  @@index([periodLabel])
}

model PLImportMapping {
  id              String          @id
  importSessionId String          @unique
  autoMap         Json
  finalMap        Json
  mappedInput     Json
  fieldConfidence Json
  manualOverrides Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
}

model PLImportParseArtifact {
  id              String          @id
  importSessionId String          @unique
  rawExtraction   Json
  qualitySignals  Json
  createdAt       DateTime        @default(now())
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
}

model PLImportSession {
  id                     String                 @id
  userId                 String?
  status                 String                 @default("uploaded")
  sourceType             String
  sourceLabel            String?
  filename               String
  mimeType               String
  sizeBytes              Int
  parserVersion          String?
  mappingVersion         String?
  overallConfidence      Int                    @default(0)
  requiredFieldsComplete Boolean                @default(false)
  errorMessage           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  PLImportBatchItem      PLImportBatchItem[]
  PLImportMapping        PLImportMapping?
  PLImportParseArtifact  PLImportParseArtifact?
  User                   User?                  @relation(fields: [userId], references: [id])
  PLImportSourceFile     PLImportSourceFile?

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model PLImportSourceFile {
  id              String          @id
  importSessionId String          @unique
  data            Bytes
  sha256          String
  isCompressed    Boolean         @default(false)
  compression     String          @default("none")
  createdAt       DateTime        @default(now())
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PdfExport {
  id                 String            @id
  userId             String?
  coachingAnalysisId String?
  sessionId          String?
  coachName          String?
  clientName         String?
  callDate           String?
  score              Int?
  metadata           Json?
  createdAt          DateTime          @default(now())
  CoachingAnalysis   CoachingAnalysis? @relation(fields: [coachingAnalysisId], references: [id])
  User               User?             @relation(fields: [userId], references: [id])

  @@index([coachingAnalysisId])
  @@index([createdAt])
  @@index([userId])
}

model User {
  id                        String             @id
  name                      String
  email                     String?            @unique
  passwordHash              String?
  role                      String             @default("coach")
  teamSection               String?
  title                     String?
  bio                       String?
  imageUrl                  String?
  isActive                  Boolean            @default(true)
  onboardingTourVersion     String?
  onboardingTourCompletedAt DateTime?
  onboardingToolIntros      Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime
  ActionLog                 ActionLog[]
  CoachingAnalysis          CoachingAnalysis[]
  LoginEvent                LoginEvent[]
  PLImportBatch             PLImportBatch[]
  PLImportSession           PLImportSession[]
  PdfExport                 PdfExport[]
  ZoomConnection            ZoomConnection[]

  @@index([email])
  @@index([role])
}

model Video {
  id        String   @id
  name      String   @unique
  data      Bytes
  mimeType  String   @default("video/mp4")
  size      Int
  createdAt DateTime @default(now())
}

model ZoomConnection {
  id            String          @id
  userId        String?
  zoomUserId    String
  zoomAccountId String
  accessToken   String
  refreshToken  String
  tokenType     String          @default("bearer")
  scope         String?
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  User          User?           @relation(fields: [userId], references: [id])
  ZoomRecording ZoomRecording[]

  @@unique([zoomUserId, zoomAccountId])
  @@index([expiresAt])
  @@index([userId])
  @@index([zoomAccountId])
}

model ZoomIngestJob {
  id              String        @id
  zoomRecordingId String
  eventType       String
  status          String        @default("queued")
  attemptCount    Int           @default(0)
  lastError       String?
  payload         Json
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  ZoomRecording   ZoomRecording @relation(fields: [zoomRecordingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([zoomRecordingId])
}

model ZoomRecording {
  id                 String            @id
  zoomConnectionId   String?
  coachingAnalysisId String?
  zoomMeetingUuid    String
  zoomMeetingId      String?
  zoomRecordingId    String?
  zoomFileId         String?
  zoomUserId         String?
  hostEmail          String?
  topic              String?
  recordingType      String?
  fileType           String?
  fileExtension      String?
  status             String            @default("queued")
  transcriptStatus   String            @default("pending")
  deleteStatus       String            @default("pending")
  sourcePayload      Json?
  transcriptText     String?
  transcriptHash     String?
  downloadUrl        String?
  recordingStartAt   DateTime?
  durationMinutes    Int?
  deleteRequestedAt  DateTime?
  deleteConfirmedAt  DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  ZoomIngestJob      ZoomIngestJob[]
  CoachingAnalysis   CoachingAnalysis? @relation(fields: [coachingAnalysisId], references: [id])
  ZoomConnection     ZoomConnection?   @relation(fields: [zoomConnectionId], references: [id])

  @@unique([zoomMeetingUuid, zoomFileId])
  @@index([coachingAnalysisId])
  @@index([recordingStartAt])
  @@index([status])
  @@index([zoomConnectionId])
  @@index([zoomUserId])
}
