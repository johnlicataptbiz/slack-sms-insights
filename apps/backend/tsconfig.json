{
  /*
   * Visit https://aka.ms/tsconfig to read more about this file.
   */
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "strict": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "types/**/*.ts", "services/**/*.ts", "api/**/*.ts", "listeners/**/*.ts", "utils/**/*.ts"],
  "exclude": ["tests/**/*", "dist/**/*", "node_modules/**/*", "scripts/**/*", "src/routes/v2.routes.ts"]
}
