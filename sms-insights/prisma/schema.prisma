  @@index([board_id, column_id, item_updated_at(sort: Desc)])
  @@index([board_id, item_id, item_updated_at(sort: Desc)])
}

model monday_call_column_latest {
  board_id        String
  item_id         String
  column_id       String
  column_title    String?
