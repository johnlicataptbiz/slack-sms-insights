import React from 'react'
import { Link } from 'react-router-dom'
import { Form, FormField, Input } from '@/components/Form'
import Button from '@/components/Button'
import { useForm } from '@/hooks/use-form'
import { useAuth } from '@/contexts/AuthContext'
import { validateEmail, validatePassword } from '@/lib/validation'

const RegisterPage: React.FC = () => {
  const { register } = useAuth()

  const { values, errors, handleChange, handleSubmit } = useForm(
    {
      email: '',
      password: '',
      confirmPassword: '',
      phoneNumber: ''
    },
    (values) => {
      const errors: Record<string, string> = {}
      
      if (!validateEmail(values.email as string)) {
        errors.email = 'Please enter a valid email address'
      }
      
      if (!validatePassword(values.password as string)) {
        errors.password = 'Password must be at least 8 characters, include uppercase, lowercase, and number'
      }
      
      if (values.password !== values.confirmPassword) {
        errors.confirmPassword = 'Passwords do not match'
      }

      return errors
    }
  )

  const onSubmit = async (formValues: typeof values) => {
    try {
      await register({
        email: formValues.email as string,
        password: formValues.password as string,
        phoneNumber: formValues.phoneNumber as string
      })
    } catch (error) {
      // Handle registration error
      console.error('Registration failed', error)
    }
  }

  return (
    <Form onSubmit={(e) => handleSubmit(e, onSubmit)}>
      <FormField 
        label="Email Address" 
        error={errors.email as string}
      >
        <Input
          type="email"
          name="email"
          value={values.email}
          onChange={handleChange}
          variant={errors.email ? 'error' : 'default'}
          placeholder="you@example.com"
        />
      </FormField>

      <FormField 
        label="Phone Number" 
      >
        <Input
          type="tel"
          name="phoneNumber"
          value={values.phoneNumber}
          onChange={handleChange}
          placeholder="+1 (555) 123-4567"
        />
      </FormField>

      <FormField 
        label="Password" 
        error={errors.password as string}
      >
        <Input
          type="password"
          name="password"
          value={values.password}
          onChange={handleChange}
          variant={errors.password ? 'error' : 'default'}
          placeholder="Create a strong password"
        />
      </FormField>

      <FormField 
        label="Confirm Password" 
        error={errors.confirmPassword as string}
      >
        <Input
          type="password"
          name="confirmPassword"
          value={values.confirmPassword}
          onChange={handleChange}
          variant={errors.confirmPassword ? 'error' : 'default'}
          placeholder="Confirm your password"
        />
      </FormField>

      <Button type="submit" className="w-full mt-4">
        Create Account
      </Button>

      <div className="text-center mt-4">
        <p className="text-sm text-gray-600">
          Already have an account?{' '}
          <Link 
            to="/login" 
            className="text-primary hover:underline"
          >
            Log in here
          </Link>
        </p>
      </div>
    </Form>
  )
}

export default RegisterPage