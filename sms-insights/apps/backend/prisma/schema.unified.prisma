// Unified Prisma Schema - Combines sms-insights and apps/backend schemas
// This is the target schema for the consolidated backend

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum SmsDirection {
  inbound
  outbound
  unknown
}

enum TcpaConsentStatus {
  OPTED_IN
  OPTED_OUT
  PENDING
  UNKNOWN
}

enum OptOutMethod {
  SMS_REPLY
  LINK_CLICK
  MANUAL
  SYSTEM
}

// Core conversation and messaging models
model Conversation {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactKey              String                   @unique @map("contact_key")
  contact_id              String?
  contact_phone           String?
  current_rep_id          String?
  last_inbound_at         DateTime?                @db.Timestamptz(6)
  last_outbound_at        DateTime?                @db.Timestamptz(6)
  last_touch_at           DateTime?                @db.Timestamptz(6)
  unreplied_inbound_count Int                      @default(0)
  nextFollowupAt          DateTime?                @map("next_followup_due_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  status                  String                   @default("open") // Changed to string for simplicity
  first_engagement_at     DateTime?                @db.Timestamptz(6)
  metadata_updated_at     DateTime?                @default(now()) @db.Timestamptz(6)
  conversation_notes      conversation_notes[]
  conversation_state      conversation_state?
  draft_suggestions       draft_suggestions[]
  inbox_contact_profiles  inbox_contact_profiles[]
  send_attempts           send_attempts[]
  sms_events              sms_events[]
  work_items              work_items?

  @@index([contactKey], map: "idx_conversations_contact_key")
  @@index([nextFollowupAt], map: "idx_conversations_next_followup_due")
  @@index([current_rep_id, last_touch_at(sort: Desc)], map: "idx_conversations_rep_last_touch")
  @@index([status], map: "idx_conversations_status")
  @@index([current_rep_id, status, last_touch_at(sort: Desc)], map: "idx_conversations_rep_status_touch")
  @@map("conversations")
}

model conversation_notes {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  author          String
  text            String
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "idx_conv_notes_cid")
}

model conversation_state {
  conversation_id                 String        @id @db.Uuid
  qualification_full_or_part_time String        @default("unknown")
  qualification_niche             String?
  conversations                   Conversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model draft_suggestions {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  suggestion      String
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
}

model inbox_contact_profiles {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  contact_name    String?
  contact_email   String?
  contact_phone   String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
  @@unique([conversation_id])
}

model send_attempts {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  message_body    String
  status          String       @default("pending")
  sent_at         DateTime?
  error_message   String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
  @@index([status])
}

model sms_events {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  slack_team_id   String
  slack_channel_id String
  slack_message_ts String
  event_ts        DateTime     @db.Timestamptz(6)
  direction       SmsDirection
  contact_id      String?
  contact_phone   String?
  contact_name    String?
  aloware_user    String?
  body            String
  line            String?
  sequence        String?
  raw             Json
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
  @@index([slack_channel_id, slack_message_ts])
  @@index([event_ts(sort: Desc)])
  @@index([direction])
}

model work_items {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @unique @db.Uuid
  priority        String       @default("medium")
  status          String       @default("open")
  assigned_to     String?
  description     String
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([priority])
  @@index([assigned_to])
}

// User and authentication models
model User {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String      @unique
  name          String?
  role          String      @default("user")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  ActionLog     ActionLog[]
  LoginEvent    LoginEvent[]

  @@index([email])
}

model ActionLog {
  id          String   @id
  actionType  String
  description String
  metadata    Json?
  userId      String?
  sessionId   String?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])

  @@index([actionType])
  @@index([createdAt])
  @@index([userId])
}

model LoginEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Coaching and analytics models
model CoachingAnalysis {
  id                     String            @id
  userId                 String?
  sessionId              String?
  coachName              String?
  clientName             String?
  qualification_full_or_part_time String?
  qualification_niche             String?
  qualification_profile           qualification_profile?
  created_at             DateTime?         @default(now())
  updated_at             DateTime?         @updatedAt
}

model qualification_profile {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coaching_analysis_id   String            @unique
  qualification_score    Int?
  qualification_reason   String?
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime          @updatedAt @db.Timestamptz(6)
  coaching_analysis      CoachingAnalysis  @relation(fields: [coaching_analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Booking and call models
model booked_calls {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slack_team_id            String
  slack_channel_id         String
  slack_message_ts         String
  event_ts                 DateTime                  @db.Timestamptz(6)
  text                     String?
  raw                      Json?
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  first_sms_touch_at       DateTime?                 @db.Timestamptz(6)
  attribution_review_queue attribution_review_queue?
  booked_call_reactions    booked_call_reactions[]

  @@unique([slack_channel_id, slack_message_ts])
  @@index([slack_channel_id, slack_message_ts], map: "idx_booked_calls_channel_ts")
  @@index([event_ts(sort: Desc)], map: "idx_booked_calls_event_ts")
}

model booked_call_reactions {
  booked_call_id String       @db.Uuid
  reaction_name  String
  reaction_count Int          @default(0)
  users          Json?
  updated_at     DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  booked_calls   booked_calls @relation(fields: [booked_call_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([booked_call_id, reaction_name])
}

model attribution_review_queue {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booked_call_id    String       @unique @db.Uuid
  status            String       @default("pending")
  assigned_to       String?
  notes             String?
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)
  booked_calls      booked_calls @relation(fields: [booked_call_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([assigned_to])
}

// Reporting and analytics models
model daily_runs {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel_id        String
  channel_name      String
  date              DateTime  @db.Date
  metrics           Json?
  summary           String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([channel_id, date])
  @@index([date])
}

// Monday.com integration models
model monday_board_registry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  board_id    String   @unique
  board_name  String
  board_type  String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([is_active])
}

// Additional integration models
model actor_directory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monday_id   String   @unique
  name        String
  email       String?
  role        String
  department  String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([is_active])
}

// Audit and compliance models
model audit_logs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String    @db.VarChar(100)
  resource_type String    @db.VarChar(100)
  resource_id   String    @db.VarChar(255)
  user_id       String?
  details       Json?     @default("{}")
  ip_address    String?   @db.Inet
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([action], map: "idx_audit_logs_action")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
}

model consent_audit_log {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id    String
  action        String
  old_status    String?
  new_status    String
  performed_by  String?
  notes         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([contact_id])
  @@index([created_at])
}

model dnc_check_log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  result     String
  checked_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([phone])
  @@index([checked_at])
}

model escalation_log {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_item_id    String
  escalated_by    String
  reason          String
  priority_before String
  priority_after  String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([work_item_id])
  @@index([created_at])
}

model goals {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  type        String
  target      Int
  period      String
  achieved    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([type])
  @@index([period])
}

model lead_attribution {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id           String
  attributed_to     String
  attribution_type  String
  confidence_score  Float?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([lead_id])
  @@index([attributed_to])
  @@index([attribution_type])
}

model lead_outcomes {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id       String
  outcome       String
  outcome_date  DateTime
  notes         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([lead_id])
  @@index([outcome])
  @@index([outcome_date])
}

model message_delivery_log {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id    String
  recipient     String
  status        String
  error_message String?
  delivered_at  DateTime?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([message_id])
  @@index([recipient])
  @@index([status])
}

model monday_call_column_history {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id       String
  column_id     String
  old_value     String?
  new_value     String?
  changed_by    String?
  changed_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([item_id])
  @@index([column_id])
  @@index([changed_at])
}

model monday_call_column_latest {
  item_id     String   @id
  column_id   String
  value       String?
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_by  String?

  @@index([column_id])
  @@index([updated_at])
}

model monday_call_snapshots {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id     String
  snapshot    Json
  taken_at    DateTime @default(now()) @db.Timestamptz(6)
  taken_by    String?

  @@index([item_id])
  @@index([taken_at])
}

model monday_column_mappings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monday_board_id String
  monday_column_id String
  field_name      String
  field_type      String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([monday_board_id])
  @@index([field_name])
  @@index([is_active])
}

model monday_metric_facts {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  board_id    String
  item_id     String
  metric_name String
  metric_value String
  recorded_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([board_id])
  @@index([item_id])
  @@index([metric_name])
  @@index([recorded_at])
}

model monday_sync_state {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  board_id      String   @unique
  last_sync_at  DateTime?
  sync_status   String   @default("never")
  error_message String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@index([sync_status])
}

model monday_weekly_reports {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_start  DateTime @db.Date
  board_id    String
  report_data Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([week_start, board_id])
  @@index([board_id])
}

model opt_out_events {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id  String
  method      OptOutMethod
  reason      String?
  performed_by String?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)

  @@index([contact_id])
  @@index([method])
  @@index([created_at])
}

model PdfExport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  fileName    String
  status      String   @default("pending")
  url         String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PLImportBatch {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchName     String
  status        String   @default("pending")
  totalRecords  Int      @default(0)
  processedRecords Int   @default(0)
  errorRecords  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PLImportBatchItem {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId       String
  recordData    Json
  status        String        @default("pending")
  errorMessage  String?
  processedAt   DateTime?
  PLImportBatch PLImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
}

model PLImportMapping {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId     String
  sourceField String
  targetField String
  transform   String?
  PLImportBatch PLImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model PLImportSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  batchId   String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  PLImportBatch PLImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PLImportSourceFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId   String
  fileName  String
  fileSize  Int
  mimeType  String
  uploadedAt DateTime @default(now())
  PLImportBatch PLImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model setter_activity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setter_id     String
  activity_type String
  details       Json?
  timestamp     DateTime @default(now()) @db.Timestamptz(6)

  @@index([setter_id])
  @@index([activity_type])
  @@index([timestamp])
}

model setter_feedback_dedupe {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setter_id     String
  feedback_hash String
  last_feedback DateTime @default(now()) @db.Timestamptz(6)

  @@unique([setter_id, feedback_hash])
  @@index([last_feedback])
}

model trend_alerts {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metric_name String
  threshold   Float
  current_value Float
  alert_type  String
  message     String
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([metric_name])
  @@index([alert_type])
  @@index([created_at])
}

model user_send_preferences {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  preference_key String
  preference_value String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([preference_key])
}

model Video {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  url         String
  thumbnail   String?
  duration    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ZoomConnection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  zoomUserId  String
  accessToken String
  refreshToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId])
  @@unique([zoomUserId])
}

model ZoomIngestJob {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoomMeetingId String
  status      String   @default("pending")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoomMeetingId])
  @@index([status])
}

model ZoomRecording {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoomMeetingId String
  recordingId   String
  downloadUrl   String
  fileSize      Int?
  duration      Int?
  recordingType String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ZoomIngestJob ZoomIngestJob? @relation(fields: [zoomMeetingId], references: [id])

  @@index([zoomMeetingId])
  @@index([recordingId])
}