{
  "servers": {
    "github.com/github/github-mcp-server": {
      "type": "local",
      "path": "mcp/github.com/github/github-mcp-server",
      "command": "docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN=${input:github_token} ghcr.io/github/github-mcp-server",
      "inputs": [
        {
          "type": "promptString",
          "id": "github_token",
          "description": "GitHub Personal Access Token",
          "password": true
        }
      ]
    },
    "github.com/modelcontextprotocol/servers/tree/main/src/filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/jl/Developer/slack-sms-insights"
      ],
      "disabled": false,
      "autoApprove": []
    }
  }
}
