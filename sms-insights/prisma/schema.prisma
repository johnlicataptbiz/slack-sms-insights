generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SmsDirection {
  inbound
  outbound
  unknown
}

enum ConversationStatus {
  open
  closed
  dnc
}

enum CadenceStatus {
  idle
  podcast_sent
  call_offered
  nurture_pool
}

enum DailyRunStatus {
  success
  error
  pending
}

enum MondaySyncStatus {
  idle
  running
  success
  error
}

enum MondayBookedCallPushStatus {
  pending
  synced
  error
  skipped
}

enum SendAttemptStatus {
  blocked
  queued
  sent
  failed
  duplicate
}

enum SequenceVersionStatus {
  active
  testing
  rewrite
  archived
}

enum WorkItemSeverity {
  low
  med
  high
}

enum WorkItemType {
  needs_reply
  follow_up
  hot_lead
}

enum SequenceRegistryStatus {
  active
  inactive
}

model Conversation {
  id                      String                   @id @default(cuid())
  contactKey              String                   @unique @map("contact_key")
  contact_id              String?
  contact_phone           String?
  current_rep_id          String?
  status                  ConversationStatus       @default(open)
  last_inbound_at         DateTime?               
  last_outbound_at        DateTime?               
  last_touch_at           DateTime?               
  unreplied_inbound_count Int                      @default(0)
  nextFollowupAt          DateTime?                @map("next_followup_due_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  conversation_notes      conversation_notes[]
  conversation_state      conversation_state?
  draft_suggestions       draft_suggestions[]
  inbox_contact_profiles  inbox_contact_profiles[]
  send_attempts           send_attempts[]
  sms_events              sms_events[]
  work_items              work_items?

  @@index([contactKey])
  @@index([nextFollowupAt])
  @@index([current_rep_id, last_touch_at(sort: Desc)])
  @@index([status])
  @@map("conversations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model actor_directory {
  canonical_name String   @id
  role           String
  aliases        String @default("[]")
  active         Boolean  @default(true)
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([role, active])
}

model audit_logs {
  id            String    @id @default(cuid())
  action        String   
  resource_type String   
  resource_id   String   
  user_id       String?  
  details       String?     @default("{}")
  ip_address    String?  
  created_at    DateTime? @default(now())

  @@index([action])
  @@index([created_at(sort: Desc)])
}

model booked_call_attribution {
  booked_call_id             String   @id
  booked_event_ts            DateTime
  booked_text                String?
  canonical_booking          Boolean  @default(false)
  mapping_method             String?
  match_confidence           Decimal?
  attribution_status         String?
  attribution_confidence_band String?
  fallback_used              Boolean  @default(false)
  needs_review               Boolean  @default(false)
  review_reason              String?
  conversation_id            String? 
  conversation_match_seconds Int?
  setter_hint                String?
  setter_final               String?
  closer_final               String?
  first_conversion           String?
  source_bucket              String?
  resolved_sequence_id       String? 
  resolved_sequence_label    String?
  attribution_path           String?
  matched_via_phone          Boolean  @default(false)
  matched_via_fuzzy          Boolean  @default(false)
  matched_via_reply_link     Boolean  @default(false)
  hubspot_contact_id         String?
  lead_score                 Decimal?
  lead_score_source          String?
  mapper_version             String   @default("v1.0")
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@index([conversation_id])
  @@index([booked_event_ts(sort: Desc)])
  @@index([setter_final])
}

model attribution_review_queue {
  id                 String   @id @default(cuid())
  booked_call_id     String  
  priority           Int      @default(0)
  issue_type         String?
  issue_summary      String?
  candidate_sequences String?
  status             String?  @default("open")
  resolved_by        String?
  resolved_at        DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  @@index([status, priority, created_at(sort: Desc)])
  @@unique([booked_call_id])
}

model booked_call_reactions {
  booked_call_id String      
  reaction_name  String
  reaction_count Int          @default(0)
  users          String?
  updated_at     DateTime     @updatedAt
  booked_calls   booked_calls @relation(fields: [booked_call_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([booked_call_id, reaction_name])
}

model booked_calls {
  id                    String                  @id @default(cuid())
  slack_team_id         String
  slack_channel_id      String
  slack_message_ts      String
  event_ts              DateTime               
  text                  String?
  raw                   String?
  created_at            DateTime                @default(now())
  first_sms_touch_at    DateTime?              
  booked_call_reactions booked_call_reactions[]

  @@unique([slack_channel_id, slack_message_ts])
  @@index([slack_channel_id, slack_message_ts])
  @@index([event_ts(sort: Desc)])
}

model conversation_notes {
  id              String       @id @default(cuid())
  conversation_id String      
  author          String
  text            String
  created_at      DateTime     @default(now())
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversation_state {
  conversation_id                 String       @id
  qualification_full_or_part_time String       @default("unknown")
  qualification_niche             String?
  qualification_revenue_mix       String       @default("unknown")
  qualification_coaching_interest String       @default("unknown")
  qualification_progress_step     Int          @default(0)
  escalation_level                Int          @default(1)
  escalation_reason               String?
  escalation_overridden           Boolean      @default(false)
  last_podcast_sent_at            DateTime?   
  next_followup_due_at            DateTime?   
  cadence_status                  CadenceStatus @default(idle)
  created_at                      DateTime     @default(now())
  updated_at                      DateTime     @updatedAt
  objection_tags                  String       @default("[]")
  guardrail_override_count        Int          @default(0)
  call_outcome                    String?
  qualification_delivery_model    String       @default("unknown")
  conversations                   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cadence_status])
  @@index([qualification_coaching_interest])
  @@index([conversation_id])
  @@index([escalation_level])
  @@index([objection_tags])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversion_examples {
  id                       String     @id @default(cuid())
  source_outbound_event_id String     @unique
  booked_call_label        String?
  closed_won_label         String?
  escalation_level         Int        @default(1)
  structure_signature      String?
  qualifier_snapshot       String?
  channel_marker           String     @default("sms")
  created_at               DateTime   @default(now())
  sms_events               sms_events @relation(fields: [source_outbound_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booked_call_label, escalation_level])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model daily_runs {
  id            String    @id @default(cuid())
  timestamp     DateTime  @default(now())
  report_date   DateTime?
  channel_id    String
  channel_name  String?
  report_type   String
  status        DailyRunStatus
  error_message String?
  summary_text  String?
  full_report   String?
  duration_ms   Int?
  created_at    DateTime  @default(now())
  is_legacy     Boolean   @default(false)

  @@index([channel_id, timestamp(sort: Desc)])
  @@index([is_legacy, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}

model draft_suggestions {
  id                     String       @id @default(cuid())
  conversation_id        String      
  prompt_snapshot_hash   String
  retrieved_exemplar_ids String?
  generated_text         String
  lint_score             Float        @default(0)
  structural_score       Float        @default(0)
  lint_issues            String?
  accepted               Boolean      @default(false)
  edited                 Boolean      @default(false)
  send_linked_event_id   String?     
  raw                    String?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt
  rejection_reason       String?
  rejection_feedback     String?
  rejected_at            DateTime?   
  conversations          Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sms_events             sms_events?  @relation(fields: [send_linked_event_id], references: [id], onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)])
}

model goals {
  id         String    @id
  name       String   
  target     Decimal  
  unit       String   
  period     String   
  created_at DateTime? @default(now())
  updated_at DateTime  @updatedAt
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inbox_contact_profiles {
  contact_key           String        @id
  conversation_id       String?      
  contact_id            String?
  aloware_contact_id    String?
  name                  String?
  phone                 String?
  email                 String?
  timezone              String?
  niche                 String?
  revenue_mix_category  String        @default("unknown")
  employment_status     String        @default("unknown")
  coaching_interest     String        @default("unknown")
  dnc                   Boolean       @default(false)
  raw                   String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  lead_source           String?
  sequence_id           String?
  disposition_status_id String?
  tags                  String?
  text_authorized       Boolean?
  is_blocked            Boolean?
  cnam_city             String?
  cnam_state            String?
  cnam_country          String?
  last_engagement_at    DateTime?    
  inbound_sms_count     Int?
  outbound_sms_count    Int?
  inbound_call_count    Int?
  outbound_call_count   Int?
