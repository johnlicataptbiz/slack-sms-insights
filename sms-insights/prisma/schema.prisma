  @@index([contact_key])
  @@index([last_engagement_at(sort: Desc)])
  @@index([lead_source])
  @@index([sequence_id])
}

model lead_attribution {
  board_id         String
  item_id          String
  lead_name        String?
  contact_key      String?
  source           String?
  setter           String?
  set_by           String?
  campaign         String?
  sequence         String?
  lead_status      String?
