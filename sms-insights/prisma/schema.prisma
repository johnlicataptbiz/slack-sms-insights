  synced_at         DateTime  @default(now())

  @@id([board_id, item_id, metric_name, item_updated_at])
  @@index([board_id, metric_date(sort: Desc)])
  @@index([metric_name, metric_date(sort: Desc)])
  @@index([metric_owner, metric_date(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model monday_sync_state {
  board_id     String    @id
