generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Enums for SMS system
enum SmsDirection {
  inbound
  outbound
}

enum TcpaConsentStatus {
  OPTED_IN
  OPTED_OUT
  PENDING
  UNKNOWN
}

enum OptOutMethod {
  SMS_REPLY
  LINK_CLICK
  MANUAL
  SYSTEM
}

model ActionLog {
  id          String   @id
  actionType  String
  description String
  metadata    Json?
  userId      String?
  sessionId   String?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])

  @@index([actionType])
  @@index([createdAt])
  @@index([userId])
}

model CoachingAnalysis {
  id                     String          @id
  userId                 String?
  sessionId              String?
  coachName              String?
  clientName             String?
  callDate               String?
  score                  Int
  outcome                String
  summary                String
  phaseScores            Json
  strengths              Json
  improvements           Json
  redFlags               Json
  gradingVersion         String          @default("v1")
  deterministic          Json?
  criticalBehaviors      Json?
  confidence             Int?
  qualityGate            Json?
  evidence               Json?
  transcriptHash         String?
  deidentifiedTranscript String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime
  User                   User?           @relation(fields: [userId], references: [id])
  PdfExport              PdfExport[]
  ZoomRecording          ZoomRecording[]

  @@index([createdAt])
  @@index([userId])
}

model KnowledgeDoc {
  id        String   @id
  slug      String?  @unique
  title     String
  content   String
  category  String
  source    String?
  version   String   @default("2026.02")
  checksum  String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category])
}

model LoginEvent {
  id         String   @id
  userId     String?
  success    Boolean  @default(true)
  rememberMe Boolean?
  sessionId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([success])
  @@index([userId])
}

model PLImportBatch {
  id                String              @id
  userId            String?
  name              String?
  programType       String              @default("mastermind")
  status            String              @default("draft")
  overallConfidence Int                 @default(0)
  timelinePayload   Json?
  warningSummary    Json?
  approvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  User              User?               @relation(fields: [userId], references: [id])
  PLImportBatchItem PLImportBatchItem[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model PLImportBatchItem {
  id              String          @id
  batchId         String
  importSessionId String
  periodLabel     String
  periodOrder     Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  PLImportBatch   PLImportBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@unique([batchId, importSessionId])
  @@unique([batchId, periodOrder])
  @@index([importSessionId])
  @@index([periodLabel])
}

model PLImportMapping {
  id              String          @id
  importSessionId String          @unique
  autoMap         Json
  finalMap        Json
  mappedInput     Json
  fieldConfidence Json
  manualOverrides Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
}

model PLImportParseArtifact {
  id              String          @id
  importSessionId String          @unique
  rawExtraction   Json
  qualitySignals  Json
  createdAt       DateTime        @default(now())
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
}

model PLImportSession {
  id                     String                 @id
  userId                 String?
  status                 String                 @default("uploaded")
  sourceType             String
  sourceLabel            String?
  filename               String
  mimeType               String
  sizeBytes              Int
  parserVersion          String?
  mappingVersion         String?
  overallConfidence      Int                    @default(0)
  requiredFieldsComplete Boolean                @default(false)
  errorMessage           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  PLImportBatchItem      PLImportBatchItem[]
  PLImportMapping        PLImportMapping?
  PLImportParseArtifact  PLImportParseArtifact?
  User                   User?                  @relation(fields: [userId], references: [id])
  PLImportSourceFile     PLImportSourceFile?

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model PLImportSourceFile {
  id              String          @id
  importSessionId String          @unique
  data            Bytes
  sha256          String
  isCompressed    Boolean         @default(false)
  compression     String          @default("none")
  createdAt       DateTime        @default(now())
  PLImportSession PLImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PdfExport {
  id                 String            @id
  userId             String?
  coachingAnalysisId String?
  sessionId          String?
  coachName          String?
  clientName         String?
  callDate           String?
  score              Int?
  metadata           Json?
  createdAt          DateTime          @default(now())
  CoachingAnalysis   CoachingAnalysis? @relation(fields: [coachingAnalysisId], references: [id])
  User               User?             @relation(fields: [userId], references: [id])

  @@index([coachingAnalysisId])
  @@index([createdAt])
  @@index([userId])
}

model User {
  id                        String             @id
  name                      String
  email                     String?            @unique
  passwordHash              String?
  role                      String             @default("coach")
  teamSection               String?
  title                     String?
  bio                       String?
  imageUrl                  String?
  isActive                  Boolean            @default(true)
  onboardingTourVersion     String?
  onboardingTourCompletedAt DateTime?
  onboardingToolIntros      Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime
  ActionLog                 ActionLog[]
  CoachingAnalysis          CoachingAnalysis[]
  LoginEvent                LoginEvent[]
  PLImportBatch             PLImportBatch[]
  PLImportSession           PLImportSession[]
  PdfExport                 PdfExport[]
  ZoomConnection            ZoomConnection[]

  @@index([email])
  @@index([role])
}

model Video {
  id        String   @id
  name      String   @unique
  data      Bytes
  mimeType  String   @default("video/mp4")
  size      Int
  createdAt DateTime @default(now())
}

model ZoomConnection {
  id            String          @id
  userId        String?
  zoomUserId    String
  zoomAccountId String
  accessToken   String
  refreshToken  String
  tokenType     String          @default("bearer")
  scope         String?
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  User          User?           @relation(fields: [userId], references: [id])
  ZoomRecording ZoomRecording[]

  @@unique([zoomUserId, zoomAccountId])
  @@index([expiresAt])
  @@index([userId])
  @@index([zoomAccountId])
}

model ZoomIngestJob {
  id              String        @id
  zoomRecordingId String
  eventType       String
  status          String        @default("queued")
  attemptCount    Int           @default(0)
  lastError       String?
  payload         Json
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  ZoomRecording   ZoomRecording @relation(fields: [zoomRecordingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([zoomRecordingId])
}

model ZoomRecording {
  id                 String            @id
  zoomConnectionId   String?
  coachingAnalysisId String?
  zoomMeetingUuid    String
  zoomMeetingId      String?
  zoomRecordingId    String?
  zoomFileId         String?
  zoomUserId         String?
  hostEmail          String?
  topic              String?
  recordingType      String?
  fileType           String?
  fileExtension      String?
  status             String            @default("queued")
  transcriptStatus   String            @default("pending")
  deleteStatus       String            @default("pending")
  sourcePayload      Json?
  transcriptText     String?
  transcriptHash     String?
  downloadUrl        String?
  recordingStartAt   DateTime?
  durationMinutes    Int?
  deleteRequestedAt  DateTime?
  deleteConfirmedAt  DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  ZoomIngestJob      ZoomIngestJob[]
  CoachingAnalysis   CoachingAnalysis? @relation(fields: [coachingAnalysisId], references: [id])
  ZoomConnection     ZoomConnection?   @relation(fields: [zoomConnectionId], references: [id])

  @@unique([zoomMeetingUuid, zoomFileId])
  @@index([coachingAnalysisId])
  @@index([recordingStartAt])
  @@index([status])
  @@index([zoomConnectionId])
  @@index([zoomUserId])
}


// SMS System Models
model inbox_contact_profiles {
  contact_id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_key                   String             @unique
  phone                         String?
  name                          String?
  email                         String?
  lead_source                   String?
  text_authorized               Boolean?           @default(false)
  is_blocked                    Boolean?           @default(false)
  last_engagement_at            DateTime?          @db.Timestamptz(6)
  created_at                    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime           @updatedAt @db.Timestamptz(6)

  // TCPA/GDPR Compliance Fields
  tcpa_consent_status           TcpaConsentStatus  @default(UNKNOWN)
  tcpa_consent_date             DateTime?          @db.Timestamptz(6)
  tcpa_consent_method           String?
  dnc_list_checked_at           DateTime?          @db.Timestamptz(6)
  dnc_list_source               String?
  gdpr_consent_status           String?
  gdpr_consent_date             DateTime?          @db.Timestamptz(6)
  last_consent_update_by        String?
  consent_update_reason         String?

  // Relations
  conversations                 conversations[]
  sms_events                    sms_events[]

  @@index([contact_key])
  @@index([phone])
  @@index([lead_source, last_engagement_at(sort: Desc)], map: "idx_inbox_profiles_source_engagement")
  @@index([text_authorized, is_blocked, last_engagement_at(sort: Desc)], map: "idx_inbox_profiles_auth_blocked_engagement")
  @@index([tcpa_consent_status])
  @@map("inbox_contact_profiles")
}

model conversations {
  id                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_key                   String
  contact_phone                 String?
  contact_id                    String?
  current_rep_id                String?
  status                        String             @default("ACTIVE")
  last_inbound_at               DateTime?          @db.Timestamptz(6)
  last_outbound_at              DateTime?          @db.Timestamptz(6)
  last_touch_at                 DateTime?          @db.Timestamptz(6)
  created_at                    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime           @updatedAt @db.Timestamptz(6)

  // Compliance Fields
  has_active_consent            Boolean            @default(false)
  consent_verified_at           DateTime?          @db.Timestamptz(6)
  is_opted_out                  Boolean            @default(false)
  opted_out_at                  DateTime?          @db.Timestamptz(6)
  opted_out_reason              String?
  is_dnc_flagged                Boolean            @default(false)
  dnc_checked_at                DateTime?          @db.Timestamptz(6)
  preferred_contact_time_start  DateTime?          @db.Time(6)
  preferred_contact_time_end    DateTime?          @db.Time(6)
  preferred_contact_timezone    String?
  messages_sent_today           Int                @default(0)
  messages_sent_this_week       Int                @default(0)
  last_message_sent_at          DateTime?          @db.Timestamptz(6)

  // Relations
  contact_profile               inbox_contact_profiles @relation(fields: [contact_key], references: [contact_key])
  sms_events                    sms_events[]
  send_attempts                 send_attempts[]
  draft_suggestions             draft_suggestions[]
  work_items                    work_items[]
  conversation_state            conversation_state[]
  conversation_notes            conversation_notes[]
  booked_calls                  booked_calls[]
  qualification_profile         qualification_profile?
  escalation_logs               escalation_log[]

  @@index([contact_key])
  @@index([status])
  @@index([current_rep_id])
  @@index([last_touch_at(sort: Desc)])
  @@index([current_rep_id, status, last_touch_at(sort: Desc)], map: "idx_conversations_rep_status_touch")
  @@index([is_opted_out])
  @@map("conversations")
}


model sms_events {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slack_team_id           String
  slack_channel_id        String
  slack_message_ts        String
  event_ts                DateTime           @db.Timestamptz(6)
  direction               SmsDirection
  contact_id              String?
  contact_phone           String?
  normalized_contact_key  String?
  normalized_phone        String?
  contact_name            String?
  aloware_user            String?
  body                    String?
  line                    String?
  sequence                String?
  sequence_id             String?            @db.Uuid
  sequence_version_id     String?            @db.Uuid
  event_role              String?
  raw                     Json?
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  conversation_id         String?            @db.Uuid

  // Compliance Fields
  was_compliant           Boolean            @default(true)
  compliance_notes        String?
  delivery_status         String?
  delivery_timestamp      DateTime?          @db.Timestamptz(6)
  carrier_code            String?
  carrier_message         String?
  contains_opt_out_keyword Boolean            @default(false)
  message_type            String?
  campaign_id             String?

  // Relations
  conversation            conversations?     @relation(fields: [conversation_id], references: [id])
  contact_profile         inbox_contact_profiles? @relation(fields: [normalized_contact_key], references: [contact_key])

  @@index([conversation_id])
  @@index([event_ts(sort: Desc)])
  @@index([direction, created_at(sort: Desc)])
  @@index([normalized_contact_key])
  @@index([conversation_id, event_ts(sort: Desc)], map: "idx_sms_events_conv_ts")
  @@map("sms_events")
}

model send_attempts {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id         String             @db.Uuid
  idempotency_key         String?            @unique
  status                  String             @default("pending")
  body                    String
  to_phone                String
  from_line               String?
  sequence_id             String?            @db.Uuid
  sequence_version_id     String?            @db.Uuid
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @updatedAt @db.Timestamptz(6)

  // Compliance Fields
  compliance_check_passed Boolean            @default(false)
  compliance_check_details Json?
  delivery_status         String?
  delivery_timestamp      DateTime?          @db.Timestamptz(6)
  carrier_error_code      String?
  carrier_error_description String?
  opt_out_detected        Boolean            @default(false)
  opt_out_timestamp       DateTime?          @db.Timestamptz(6)

  // Relations
  conversation            conversations      @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id])
  @@index([status, created_at(sort: Desc)])
  @@index([idempotency_key])
  @@index([conversation_id, status], map: "idx_send_attempts_conv_status")
  @@map("send_attempts")
}

model conversation_state {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id        String             @unique @db.Uuid
  cadence_status         String             @default("active")
  escalation_level       String             @default("none")
  qualification_score    Int?
  qualification_status   String?
  last_qualification_at  DateTime?          @db.Timestamptz(6)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @updatedAt @db.Timestamptz(6)

  // Additional engagement tracking fields (DB-008)
  total_messages_sent         Int                @default(0)
  total_messages_received     Int                @default(0)
  response_rate               Decimal?           @db.Decimal(5,2)
  avg_response_time_minutes   Int?
  qualification_completed_at  DateTime?          @db.Timestamptz(6)
  qualification_completed_by  String?
  escalation_created_at       DateTime?          @db.Timestamptz(6)
  escalation_resolved_at      DateTime?          @db.Timestamptz(6)
  escalation_resolved_by      String?
  booked_call_count           Int                @default(0)
  completed_call_count        Int                @default(0)
  last_call_booked_at         DateTime?          @db.Timestamptz(6)
  last_consent_verified_at    DateTime?          @db.Timestamptz(6)
  is_compliant                Boolean            @default(true)

  // Relations
  conversation           conversations      @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([cadence_status])
  @@index([escalation_level])
  @@map("conversation_state")
}

model conversation_notes {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String             @db.Uuid
  author          String
  text            String
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at      DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  conversation    conversations      @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@map("conversation_notes")
}

model work_items {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String             @db.Uuid
  rep_id          String
  type            String
  status          String             @default("open")
  priority        String             @default("medium")
  title           String
  description     String?
  due_at          DateTime?          @db.Timestamptz(6)
  resolved_at     DateTime?          @db.Timestamptz(6)
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at      DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  conversation    conversations      @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id])
  @@index([rep_id])
  @@index([resolved_at])
  @@map("work_items")
}

model draft_suggestions {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String             @db.Uuid
  suggestion      String
  confidence      Float?
  accepted        Boolean?           @default(false)
  edited          Boolean?           @default(false)
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at      DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  conversation    conversations      @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id])
  @@map("draft_suggestions")
}

model booked_calls {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id    String             @db.Uuid
  slack_team_id      String
  slack_channel_id   String
  slack_message_ts   String
  event_ts           DateTime           @db.Timestamptz(6)
  call_type          String
  booked_by          String
  booked_with        String
  notes              String?
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  conversation       conversations     @relation(fields: [conversation_id], references: [id])
  reactions          booked_call_reactions[]

  @@index([conversation_id])
  @@index([event_ts(sort: Desc)])
  @@map("booked_calls")
}

model booked_call_reactions {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booked_call_id String             @db.Uuid
  user_id        String
  reaction       String
  created_at     DateTime           @default(now()) @db.Timestamptz(6)

  // Relations
  booked_call    booked_calls       @relation(fields: [booked_call_id], references: [id], onDelete: Cascade)

  @@index([booked_call_id])
  @@map("booked_call_reactions")
}


model consent_audit_log {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id            String
  contact_key           String
  previous_consent_status String?
  new_consent_status    String
  changed_by            String?
  change_reason         String?
  created_at            DateTime           @default(now()) @db.Timestamptz(6)

  @@index([contact_key])
  @@map("consent_audit_log")
}

model dnc_check_log {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id    String
  phone         String
  dnc_status    Boolean
  checked_at    DateTime           @default(now()) @db.Timestamptz(6)
  check_source  String?
  created_at    DateTime           @default(now()) @db.Timestamptz(6)

  @@map("dnc_check_log")
}

model opt_out_events {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id     String             @db.Uuid
  contact_id          String
  contact_phone       String
  opt_out_method      OptOutMethod
  opt_out_timestamp   DateTime           @db.Timestamptz(6)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)

  @@index([conversation_id])
  @@map("opt_out_events")
}

model message_delivery_log {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  send_attempt_id  String             @db.Uuid
  conversation_id  String             @db.Uuid
  status           String
  status_timestamp DateTime           @db.Timestamptz(6)
  carrier_code     String?
  carrier_message  String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)

  @@index([send_attempt_id])
  @@index([conversation_id])
  @@map("message_delivery_log")
}

model qualification_profile {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id        String             @unique @db.Uuid
  qualification_score    Int?
  qualification_status   String?
  last_qualification_at  DateTime?          @db.Timestamptz(6)
  qualification_completed_at DateTime?      @db.Timestamptz(6)
  qualification_completed_by String?
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  conversation           conversations      @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@map("qualification_profile")
}

model escalation_log {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id        String             @db.Uuid
  escalation_level       String
  escalation_created_at  DateTime?          @db.Timestamptz(6)
  escalation_resolved_at DateTime?          @db.Timestamptz(6)
  escalation_resolved_by String?
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @updatedAt @db.Timestamptz(6)

  // Relations
  conversation           conversations      @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([escalation_level])
  @@map("escalation_log")
}

model user_send_preferences {
  user_id                        String             @id
  max_messages_per_day           Int                @default(50)
  max_messages_per_contact_per_day Int              @default(5)
  quiet_hours_start               DateTime?          @db.Time(6)
  quiet_hours_end                 DateTime?          @db.Time(6)
  quiet_hours_timezone            String?
  auto_opt_out_on_keyword         Boolean            @default(true)
  require_consent_verification    Boolean            @default(true)
  created_by                      String?
  updated_by                      String?
  enable_ai_drafts                Boolean            @default(true)
  enable_auto_followup            Boolean            @default(true)
  enable_compliance_checks        Boolean            @default(true)
  created_at                      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime           @updatedAt @db.Timestamptz(6)

  @@map("user_send_preferences")
}

model goals {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  target     Int
  achieved   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
