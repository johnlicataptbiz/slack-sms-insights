{"name":"ptbizsms-api","version":"1.0.2","type":"module","scripts":{"build":"npm run clean && npm run prebuild && npm run prisma:generate && tsc","dev":"tsx watch src/app.ts","clean":"node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"","prebuild":"node --import tsx ./scripts/generate-changelog-json.ts","prisma:generate":"prisma generate --config prisma.config.ts","typecheck":"tsc -p tsconfig.json --noEmit","lint":"biome check src/"},"dependencies":{"@prisma/client":"^7.4.2","@slack/bolt":"^3.17.1","compression":"^1.8.1","cors":"^2.8.5","dotenv":"^16.4.7","express":"^4.22.1","express-rate-limit":"^7.5.1","helmet":"^8.1.0","libphonenumber-js":"^1.10.61","tsx":"^4.7.2","zod":"^3.23.8"},"devDependencies":{"@biomejs/biome":"1.5.3","@types/express":"^4.17.23","@types/node":"^22.0.2","prisma":"^7.4.2","ts-node":"^10.9.2","typescript":"^5.4.5","vitest":"^1.6.0"}}
